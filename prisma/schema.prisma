// Prisma schema for Persian Math Factoring Platform
// به افتخار Jamshid al-Kashi (الکاشی)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Users =====
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  phone         String?  // شماره موبایل ایرانی
  phoneVerified Boolean  @default(false) // احراز هویت موبایل
  role          String   @default("user") // user, admin, superadmin
  credits       Int      @default(0) // FactorDB credits
  avatar        String?
  bio           String?
  country       String?  @default("Iran")
  language      String   @default("fa") // fa, en, ar
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  factors       Factor[]
  articles      Article[]
  comments      Comment[]
  sessions      Session[]
}

// ===== Sessions (login tracking) =====
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ip        String?
  userAgent  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===== Factored Numbers =====
model Factor {
  id          String   @id @default(cuid())
  number      String   // the composite number
  digits      Int      // number of digits
  factors     String   // JSON array of factors
  numFactors  Int      // count of prime factors
  isPrime     Boolean  @default(false)
  source      String   @default("manual") // kashani, khayyam, biruni, manual, auto
  series      String?  // which series (kashani, khayyam, etc.)
  userId      String?  // who factored it
  factordbId  String?  // FactorDB fid
  credited    Boolean  @default(false) // credited in FactorDB
  verified    Boolean  @default(false) // factors verified
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id])
}

// ===== Range Coverage (frontier tracking) =====
model Range {
  id          String   @id @default(cuid())
  startNum    BigInt
  endNum      BigInt
  primesCount Int
  compositesCount Int
  unfactoredCount Int @default(0)
  isComplete  Boolean  @default(false)
  timeSeconds Float?
  createdAt   DateTime @default(now())
}

// ===== Articles (Magazine/Journal) =====
model Article {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?
  titleAr     String?
  slug        String   @unique
  excerpt     String?
  content     String   // full content (markdown)
  contentEn   String?  // English version
  contentAr   String?  // Arabic version
  imageUrl    String?
  category    String   @default("math") // math, science, medical, news
  tags        String?  // comma-separated
  authorId    String?  // user who wrote it (or AI)
  isAI        Boolean  @default(false) // generated by AI
  isPublished Boolean  @default(false)
  views       Int      @default(0)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User?    @relation(fields: [authorId], references: [id])
  comments    Comment[]
}

// ===== Comments =====
model Comment {
  id        String   @id @default(cuid())
  articleId String?
  factorId  String?
  userId    String
  content   String
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===== Settings (CMS config) =====
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ===== Math Series (Kashani, Khayyam, etc.) =====
model MathSeries {
  id          String   @id @default(cuid())
  name        String   // Kashani, Khayyam, Biruni, etc.
  nameEn      String
  nameAr      String?
  mathematician String  // full name
  mathematicianEn String
  century     Int      // century CE
  bornYear    Int?
  diedYear    Int?
  description String
  descriptionEn String?
  oeisRef     String?  // OEIS reference
  formula     String?   // mathematical formula
  color       String?   // theme color
  icon        String?   // emoji or icon
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// ===== Volunteer Compute Nodes =====
model ComputeNode {
  id          String   @id @default(cuid())
  userId      String?
  nodeName    String
  os          String?  // operating system
  cpuCores    Int?
  ramMB       Int?
  totalWork   BigInt   @default(0) // total numbers processed
  totalCredit  Int      @default(0)
  lastSeen    DateTime?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
