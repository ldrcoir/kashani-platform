<?php
// ============================================================
// .htaccess — Apache rewrite rules (cPanel compatible)
// ============================================================

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Pretty URLs
RewriteRule ^series$ series.php [L]
RewriteRule ^ranges$ ranges.php [L]
RewriteRule ^magazine$ magazine.php [L]
RewriteRule ^about$ about.php [L]
RewriteRule ^login$ login.php [L]
RewriteRule ^register$ register.php [L]
RewriteRule ^factor$ factor.php [L]
RewriteRule ^network$ network.php [L]
RewriteRule ^article/([a-z0-9-]+)$ article.php?slug=$1 [L]
RewriteRule ^admin$ admin/index.php [L]

# Security
<Files "config.php">
    Require all denied
</Files>
<Files "database.php">
    Require all denied
</Files>

# Prevent directory listing
Options -Indexes

# Compress
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
</IfModule>

# Cache
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
