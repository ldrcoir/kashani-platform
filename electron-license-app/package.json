{
  "name": "electron-license-demo",
  "version": "1.0.0",
  "description": "برنامه دمو Electron با سیستم لایسنس و دوره آزمایشی ۱۴ روزه",
  "main": "main.js",
  "author": {
    "name": "Demo Author",
    "email": "demo@example.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "keygen": "node keygen/keygen.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:nsis": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.demo.licenseapp",
    "productName": "LicenseDemo",
    "copyright": "Copyright © 2026 Demo",
    "directories": {
      "output": "build",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "LicenseDemo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LicenseDemo",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": ["en_US"],
      "language": "1033"
    }
  }
}
